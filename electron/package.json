{
  "name": "lumi-dm",
  "version": "1.0.0",
  "description": "Lumi Download Manager",
  "main": "main.js",
  "scripts": {
    "prepare:branding": "python ../scripts/normalize_branding.py",
    "prepare:icons": "python prepare-icons.py",
    "prestart": "npm run prepare:branding && npm run prepare:icons",
    "start": "electron .",
    "prebuild": "npm run prepare:branding && npm run prepare:icons",
    "build": "electron-builder --dir",
    "pack": "npm run prepare:branding && npm run prepare:icons && electron-builder --dir"
  },
  "build": {
    "appId": "com.lumi.dm",
    "productName": "Lumi DM",
    "copyright": "THETECHGUY DIGITAL SOLUTIONS",
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "main.js",
      "native-session.js",
      "server-supervisor.js",
      "connection-capacity.js",
      "desktop-command-poller.js",
      "update-manager.js",
      "preload-main.js",
      "preload-widget.js",
      "preload-confirm.js",
      "widget.html",
      "confirm.html",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../static",
        "to": "static",
        "filter": ["**/*"]
      },
      {
        "from": "../Resouces",
        "to": "Resouces",
        "filter": ["**/*"]
      },
      {
        "from": "../assets/windows/Lumi-DM.ico",
        "to": "assets/windows/Lumi-DM.ico"
      },
      {
        "from": "../browser-extension",
        "to": "browser-extension",
        "filter": ["**/*"]
      },
      {
        "from": "../dist/server",
        "to": "server",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "../assets/windows/Lumi-DM.ico"
    },
    "mac": {
      "icon": "../assets/macos/Lumi-DM.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "../assets/linux/Lumi-DM-512.png",
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  }
}
